auth/tokens.json

# Google OAuth client secret — never commit
client_secret_*.apps.googleusercontent.com.json

# Job queue — local state, not versioned
jobs.json

# Watch folder — contains user video files
watch_input/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Environment variables
.env
.env.local
.env.production
# .env.example is intentionally NOT ignored — it is committed as documentation

# IDE
.idea/
.vscode/

# OS
Thumbs.db
desktop.ini
.DS_Store
