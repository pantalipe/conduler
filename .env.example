# conduler — environment variable reference
# Copy to .env and fill in the platform credentials you actually use.
# All vars are optional — OAuth secrets default to empty (platform disabled).

# ── File watcher ──────────────────────────────────────────────────────────────

# Folder that conduler monitors for new video files dropped by rotman
WATCH_FOLDER=./watch_input

# ── Attribution ────────────────────────────────────────────────────────────────

# Base URL appended (with UTM params, see utm.py) to every published
# description, so analytics on the dapp side can attribute visits back to
# the exact channel/video/platform that drove them.
DAPP_BASE_URL=https://pandapointscoin.com

# Public Telegram community groups, linked from the "join_community" CTA
# via the /hub page (hub.tsx picks pt/en by the channel forwarded in the
# URL). Source of truth is gitmanager/global_config.json — run
# `panda config sync` after changing these there instead of editing by hand.
TELEGRAM_COMMUNITY_URL_PT=https://t.me/+ZS3guglqYLJiOGEx
TELEGRAM_COMMUNITY_URL_EN=https://t.me/+deIOtxE00LdhNWZh

# ── Instagram / Facebook (Meta) ───────────────────────────────────────────────

# App ID from https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID_HERE

# App secret from the same Facebook Developer app dashboard
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET_HERE

# ── YouTube / Google ──────────────────────────────────────────────────────────

# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID_HERE

# OAuth 2.0 Client Secret (same credentials page)
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET_HERE

# ── TikTok ────────────────────────────────────────────────────────────────────

# Client Key from https://developers.tiktok.com/ → your app → App info
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY_HERE

# Client Secret from the same TikTok Developer app dashboard
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET_HERE
